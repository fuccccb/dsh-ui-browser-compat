{
  "name": "@deepseek-ai/dsh-client-ui-browser-compat",
  "description": "DSH Web client plugin: turns the silent \"Reconnecting\" loop on an old browser engine into an explained, fixable error",
  "version": "0.2.1-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^0.2.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "browser-compatibility",
    "webview",
    "via"
  ]
}
